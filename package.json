{
  "name": "nutri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"node --watch --import tsx server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "vite build",
    "start": "node --import tsx server/index.ts --production",
    "preview": "vite preview",
    "lint": "eslint src server shared",
    "typecheck": "vue-tsc -p ./tsconfig.app.json && tsc -p ./server/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.2",
    "@tanstack/table-core": "^8.21.3",
    "@unhead/vue": "^3.4.1",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.12",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
