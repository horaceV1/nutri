# USDA FoodData Central API key — https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Initial administrator, created on first start when no admin exists.
# Leave ADMIN_PASSWORD empty to have one generated and printed to the console.
ADMIN_EMAIL=admin@nutri.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Public URL of the web app (the OAuth redirect URI is derived from it).
APP_URL=http://localhost:5173
API_PORT=3001

# Optional: JWT signing secret. If unset, one is generated and stored in the database.
# JWT_SECRET=
# DB_FILE=server/data/nutri.db
